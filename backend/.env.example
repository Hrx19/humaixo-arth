NODE_ENV=development
PORT=5000

# Keep your real MongoDB Atlas URI in backend/.env. Never commit backend/.env.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/humaixo_arth?retryWrites=true&w=majority

# Generate a unique random value of at least 32 characters for local development.
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters-long

# Comma-separated browser origins. Native mobile requests generally have no Origin header.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

LOG_LEVEL=debug
MONGO_MAX_RETRIES=10
AI_SERVICE_URL=http://localhost:5001/parse-sms
# Use the same random 32+ character value in ai-service/.env for production.
AI_SERVICE_API_KEY=

# OAuth client IDs are public identifiers; corresponding client secrets remain here.
# Map every Google web, Android and iOS client ID to its secret. Native client
# secrets may be empty; the server verifies the returned ID token and audience.
GOOGLE_OAUTH_CLIENTS_JSON={}

# GitHub: map each web/native OAuth App client ID to its client secret.
# GitHub requires separate OAuth Apps when web and native callback URLs differ.
GITHUB_OAUTH_CLIENTS_JSON={}

# Comma-separated exact redirect URIs from HumaixoArth/.env and provider consoles.
# Do not use wildcards. Production web redirects must use HTTPS.
OAUTH_ALLOWED_REDIRECT_URIS=
