# Backend API address. Web uses localhost; native dev builds infer the Expo LAN
# host when this remains localhost. Production builds must use an HTTPS API URL.
EXPO_PUBLIC_API_URL=http://localhost:5000

# Public OAuth client IDs are safe to bundle; never put client secrets here.
# Google Android OAuth is configured in Google Cloud with package + signing SHA-1.
# The native SDK requests its verified ID token through the Web client ID.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Web callback override. Use this exact URI in Google Cloud Console and in the
# backend OAUTH_ALLOWED_REDIRECT_URIS list.
EXPO_PUBLIC_GOOGLE_WEB_REDIRECT_URI=http://localhost:8081/oauth/google

# GitHub requires a separate OAuth App when native and web callback URLs differ.
EXPO_PUBLIC_GITHUB_NATIVE_CLIENT_ID=
EXPO_PUBLIC_GITHUB_WEB_CLIENT_ID=
EXPO_PUBLIC_GITHUB_CLIENT_ID=
EXPO_PUBLIC_GITHUB_NATIVE_REDIRECT_URI=humaixoarth://oauth/github
EXPO_PUBLIC_GITHUB_WEB_REDIRECT_URI=http://localhost:8081/oauth/github
